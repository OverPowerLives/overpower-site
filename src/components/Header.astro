---
const { pathname } = Astro.url;
const isOn = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const nav = [
  { href: '/card-gallery/', label: 'Cards' },
  { href: '/play/',         label: 'Play Network' },
  { href: '/errata/',       label: 'Errata' },
  { href: '/quickstart/',   label: 'Learn' },
  { href: '/resources/',    label: 'Resources' },
  { href: '/news/',         label: 'News' },
  { href: '/about/',        label: 'About' },
];

// The store is a different system on a different subdomain. It is deliberately
// an external link, not a nav peer — Shopify owns everything past this point.
const STORE = 'https://store.overpowercardgame.com';
---

<header class="site-head">
  <div class="shell-wide head-inner">
    <a href="/" class="brand" aria-label="OverPower TCG — home">
      <span class="brand-mark" aria-hidden="true">OP</span>
      <span class="brand-word">OverPower</span>
    </a>

    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { on: isOn(item.href) }]}
          aria-current={isOn(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="head-actions">
      <a class="btn btn-primary btn-store" href={STORE}>Store</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Main (mobile)" hidden>
    {nav.map((item) => <a href={item.href} class:list={['m-link', { on: isOn(item.href) }]}>{item.label}</a>)}
    <a href={STORE} class="m-link m-store">Store &rarr;</a>
  </nav>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .head-inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 68px;
  }

  .brand { display: flex; align-items: center; gap: var(--s-3); text-decoration: none; color: var(--ink); flex: none; }
  .brand-mark {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: .04em;
    background: var(--brand-red);
    color: #fff;
    padding: 5px 8px 4px;
    border-radius: 2px;
    line-height: 1;
  }
  .brand-word {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: .02em;
    line-height: 1;
  }

  .nav { display: flex; align-items: center; gap: var(--s-1); margin-left: auto; }
  .nav-link {
    font-family: var(--f-display);
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .05em;
    text-decoration: none;
    color: var(--ink-2);
    padding: 8px 11px;
    border-radius: 2px;
    white-space: nowrap;
    transition: color .15s ease, background-color .15s ease;
  }
  .nav-link:hover { color: var(--ink); background: var(--surface-2); }
  .nav-link.on { color: var(--ink); box-shadow: inset 0 -2px 0 var(--brand-red); }

  .head-actions { display: flex; align-items: center; gap: var(--s-3); flex: none; }
  .btn-store { font-size: 15px; padding: 9px 18px; }

  .burger { display: none; background: none; border: 1px solid var(--rule-2); border-radius: 2px; padding: 9px 8px; cursor: pointer; }
  .burger span { display: block; width: 18px; height: 2px; background: var(--ink); border-radius: 2px; }
  .burger span + span { margin-top: 4px; }

  .mobile-nav { display: none; flex-direction: column; border-top: 1px solid var(--rule); padding: var(--s-2) var(--s-5) var(--s-4); }
  .mobile-nav[hidden] { display: none; }
  .m-link {
    font-family: var(--f-display); font-size: 17px; font-weight: 500;
    text-transform: uppercase; letter-spacing: .04em; text-decoration: none;
    color: var(--ink-2); padding: 11px 0; border-bottom: 1px solid var(--rule);
  }
  .m-link.on { color: var(--ink); }
  .m-store { color: var(--brand-red-lift); border-bottom: 0; }

  @media (max-width: 1080px) {
    .nav { display: none; }
    .burger { display: block; }
    .mobile-nav.open { display: flex; }
  }
  @media (max-width: 460px) {
    .brand-word { display: none; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    panel?.classList.toggle('open', !open);
    if (panel) panel.hidden = open;
  });
</script>
