---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// The eight card slots are the game's own structure — they organise the gallery,
// the errata filters and this section alike.
const pillars = [
  {
    href: '/quickstart/',
    eyebrow: 'Start here',
    title: 'Learn the game',
    body: 'Quickstart demo, the full rulebook, and a beginners guide that gets you to your first match.',
  },
  {
    href: '/card-gallery/',
    eyebrow: '472 cards',
    title: 'Browse the cards',
    body: 'Every card in the set, filterable by slot — Character, Special, Mission Objective, Event, Universe, Location, Battleground and Power.',
  },
  {
    href: '/play/',
    eyebrow: 'Play Network',
    title: 'Find a table',
    body: 'Sanctioned venues, regional events and the stores running OverPower near you.',
  },
];
---

<Base title="OverPower" description="The superhero trading card game. Originally released in 1995, relaunched and in print again.">

  <section class="hero">
    <div class="shell-wide hero-inner">
      <p class="eyebrow">Superhero trading card game &middot; In print</p>
      <h1>Every hero<br />has a <em>breaking point</em></h1>
      <p class="lede hero-lede">
        Build a team, spend your power, and outlast the other side. OverPower first
        shipped in 1995. It is back in print, with Invincible and The Walking Dead
        joining the roster.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/quickstart/">Learn to play</a>
        <a class="btn btn-ghost" href="https://store.overpowercardgame.com">Buy a starter deck</a>
      </div>
    </div>
  </section>

  <section class="pillars">
    <div class="shell-wide pillar-grid">
      {pillars.map((p) => (
        <a class="pillar" href={p.href}>
          <span class="eyebrow">{p.eyebrow}</span>
          <h2>{p.title}</h2>
          <p>{p.body}</p>
          <span class="pillar-go" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="latest">
    <div class="shell-wide">
      <div class="sec-head">
        <h2>Latest news</h2>
        <a href="/news/" class="sec-more">All news &rarr;</a>
      </div>
      <div class="news-grid">
        {posts.map((post) => (
          <article class="ncard">
            <a href={`/${post.id}/`}>
              <span class="eyebrow">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <time datetime={post.data.pubDate.toISOString()} class="tnum ncard-date">{fmt(post.data.pubDate)}</time>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="store-strip">
    <div class="shell-wide strip-inner">
      <div>
        <span class="eyebrow">The store</span>
        <h2>Boosters, starters and playmats</h2>
        <p class="lede">
          Shipping from store.overpowercardgame.com. In Phase 4 these become live
          product cards pulled straight from Shopify, purchasable without leaving the page.
        </p>
      </div>
      <a class="btn btn-primary" href="https://store.overpowercardgame.com">Visit the store</a>
    </div>
  </section>

</Base>

<style>
  /* ---- hero ---- */
  .hero {
    padding-block: var(--s-9) var(--s-8);
    border-bottom: 1px solid var(--rule);
    background:
      radial-gradient(120% 90% at 12% 0%, color-mix(in srgb, var(--brand-red) 16%, transparent) 0%, transparent 62%),
      var(--ground);
  }
  .hero h1 { margin-top: var(--s-4); }
  .hero h1 em { font-style: normal; color: var(--brand-red-lift); }
  .hero-lede { margin-top: var(--s-5); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  /* ---- pillars ---- */
  .pillars { padding-block: var(--s-8); }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  @media (max-width: 900px) { .pillar-grid { grid-template-columns: 1fr; } }

  .pillar {
    display: block; position: relative;
    background: var(--surface); padding: var(--s-6) var(--s-5) var(--s-7);
    text-decoration: none; color: var(--ink);
    transition: background-color .18s ease;
  }
  .pillar:hover { background: var(--surface-2); color: var(--ink); }
  .pillar h2 { font-size: var(--t-xl); margin-top: var(--s-3); }
  .pillar p { color: var(--ink-2); font-size: var(--t-sm); margin-top: var(--s-3); }
  .pillar-go {
    position: absolute; right: var(--s-5); bottom: var(--s-5);
    color: var(--brand-red-lift); font-size: var(--t-lg);
  }

  /* ---- latest news ---- */
  .latest { padding-block: var(--s-7) var(--s-8); }
  .sec-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4);
    padding-bottom: var(--s-4); border-bottom: 2px solid var(--ink); margin-bottom: var(--s-6);
  }
  .sec-more {
    font-family: var(--f-mono); font-size: var(--t-xs); font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; text-decoration: none;
    color: var(--ink-3); white-space: nowrap;
  }
  .sec-more:hover { color: var(--brand-red-lift); }

  .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-5); }
  @media (max-width: 900px) { .news-grid { grid-template-columns: 1fr; } }

  .ncard a {
    display: flex; flex-direction: column; gap: var(--s-3);
    text-decoration: none; color: var(--ink);
    border-top: 2px solid var(--rule-2); padding-top: var(--s-4);
    transition: border-color .18s ease;
    height: 100%;
  }
  .ncard a:hover { border-color: var(--brand-red); color: var(--ink); }
  .ncard h3 { font-size: var(--t-lg); }
  .ncard-date { font-size: var(--t-xs); color: var(--ink-3); font-family: var(--f-mono); margin-top: auto; }

  /* ---- store strip ---- */
  .store-strip { border-top: 1px solid var(--rule); background: var(--surface); padding-block: var(--s-8); }
  .strip-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-6); flex-wrap: wrap; }
  .strip-inner h2 { font-size: var(--t-2xl); margin-top: var(--s-3); }
  .strip-inner .lede { margin-top: var(--s-3); }
</style>
